# JWT authentication (durations are in seconds)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=2592000

# Backend server (Swagger is served on the same port at /api-docs)
PORT=5000
SWAGGER_PORT=5000

# Database - XAMPP MySQL/MariaDB (default: user root, no password, port 3306)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root@localhost:3306/survey"

# First admin account created by `npm run seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Administrator
