# Public API URL - the browser calls this address.
#   Local only:            http://localhost:5000
#   Via Cloudflare tunnel: https://surveysever.intech.io.vn
NEXT_PUBLIC_BACKEND_API_URL=https://surveysever.intech.io.vn

# API URL used by the Next.js server itself (token refresh in src/proxy.ts).
# The web and API run on the same machine, so localhost is faster and safer.
NEXT_SERVER_API_URL=http://localhost:5000

# Leave empty: cookies are bound to the web domain (survey.intech.io.vn).
NEXT_PUBLIC_COOKIE_DOMAIN=
COOKIE_HTTP_ONLY=true
